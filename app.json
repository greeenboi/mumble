{
  "expo": {
    "name": "mumble",
    "slug": "mumble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mumble",
    "userInterfaceStyle": "light",    
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.greenarcade.mumble"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "bf15aac2-fdd5-4cfd-8096-e91bd4f37f3e"
      }
    },
    "owner": "greenarcade",
    "experiments": {
      "typedRoutes": true
    }
  }
}
